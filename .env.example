# Copy to .env.local for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guestlist
SESSION_SECRET=change-me

# --- Event Supply Engine (V2A) ---
# AI extraction (optional; without it, extraction runs structured-data-only
# and everything lands in admin review):
# ANTHROPIC_API_KEY=sk-ant-...
# EXTRACTION_AI_MODEL=claude-haiku-4-5-20251001

# Secret for the scheduled source-polling endpoint (POST /api/jobs/scan-sources):
# SUPPLY_CRON_SECRET=generate-a-long-random-string

# DEV/TEST ONLY — never set in production. Lets automated tests fetch fixture
# servers on 127.0.0.1 through the SSRF-hardened fetcher:
# SUPPLY_FETCH_ALLOW_HOSTS=127.0.0.1

# --- Artist Video Archive ---
# Official YouTube Data API v3 key. Used server-side only to inventory/sync the
# Guestlist YouTube channel. Video files remain hosted by YouTube.
# YOUTUBE_API_KEY=...
