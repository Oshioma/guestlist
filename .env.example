# Copy to .env.local for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guestlist
SESSION_SECRET=change-me

# --- Event Supply Engine (V2A) ---
# AI extraction (optional; without it, extraction runs structured-data-only
# and everything lands in admin review):
# ANTHROPIC_API_KEY=sk-ant-...
# EXTRACTION_AI_MODEL=claude-haiku-4-5-20251001

# Secret for the scheduled source-polling endpoint (POST /api/jobs/scan-sources):
# SUPPLY_CRON_SECRET=generate-a-long-random-string

# DEV/TEST ONLY — never set in production. Lets automated tests fetch fixture
# servers on 127.0.0.1 through the SSRF-hardened fetcher:
# SUPPLY_FETCH_ALLOW_HOSTS=127.0.0.1

# --- Balance editorial ---
# Uses the same Anthropic key above. ARTICLE_AI_MODEL is optional.
# ARTICLE_AI_MODEL=claude-sonnet-4-6
# Image search keys are server-side only. Guestlist searches both providers together.
# UNSPLASH_ACCESS_KEY=...
# PEXELS_API_KEY=...
# Supabase Storage is used for selected Pexels images. Keep the service-role key server-only.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# --- Artist Video Archive ---
# Official YouTube Data API v3 key. Used server-side only to inventory/sync the
# Guestlist YouTube channel. Video files remain hosted by YouTube.
# YOUTUBE_API_KEY=...

# Owner-authorized YouTube captions. Create a Google OAuth 2.0 Web application
# client and add the exact callback URL below as an Authorized redirect URI.
# YOUTUBE_OAUTH_CLIENT_ID=...
# YOUTUBE_OAUTH_CLIENT_SECRET=...
# YOUTUBE_OAUTH_REDIRECT_URI=https://clubguestlists.com/api/admin/video-archive/youtube/callback
# Random secret used only to encrypt the stored YouTube refresh token. Generate
# a long random value and keep it stable; changing it requires reconnecting YouTube.
# YOUTUBE_OAUTH_ENCRYPTION_KEY=...
